<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-w: 250px;
            --topbar-h: 56px;
            --primary: #2563eb;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --sidebar-active: #2563eb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: #f1f5f9;
            font-family: 'Segoe UI',sans-serif;
            margin: 0;
        }

        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--topbar-h);
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            padding: 0 20px;
            z-index: 1000;
            gap: 12px;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
        }

            .topbar .brand {
                font-weight: 700;
                font-size: 1.1rem;
                color: var(--primary);
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .topbar .ms-auto {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .sidebar {
            position: fixed;
            top: var(--topbar-h);
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: var(--sidebar-bg);
            overflow-y: auto;
            z-index: 900;
            padding: 16px 10px;
        }

        .sidebar-section {
            color: #475569;
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            padding: 12px 10px 4px;
            font-weight: 600;
        }

        .sidebar .nav-link {
            color: #94a3b8;
            border-radius: 8px;
            padding: 9px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: .875rem;
            margin-bottom: 2px;
            transition: all .15s;
            text-decoration: none;
        }

            .sidebar .nav-link:hover {
                background: var(--sidebar-hover);
                color: #e2e8f0;
            }

            .sidebar .nav-link.active {
                background: var(--sidebar-active);
                color: #fff;
                font-weight: 600;
            }

            .sidebar .nav-link i {
                width: 18px;
                text-align: center;
                font-size: 1rem;
                flex-shrink: 0;
            }

        .main-wrap {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 28px;
            min-height: calc(100vh - var(--topbar-h));
        }

        .page-header {
            margin-bottom: 24px;
        }

            .page-header h4 {
                font-weight: 700;
                margin-bottom: 4px;
            }

            .page-header p {
                color: #64748b;
                margin: 0;
            }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,.07);
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
            padding: 14px 20px;
            font-weight: 600;
            border-bottom: 1px solid #f1f5f9;
        }

        .table thead th {
            font-size: .75rem;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: .6px;
            border-bottom: 2px solid #e2e8f0;
            padding: 10px 14px;
        }

        .table tbody td {
            padding: 12px 14px;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background: #f8fafc;
        }

        .badge-active {
            background: #dcfce7;
            color: #15803d;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: .75rem;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #b91c1c;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: .75rem;
        }

        .badge-admin {
            background: #ede9fe;
            color: #7c3aed;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: .75rem;
        }

        .badge-user {
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: .75rem;
        }

        .btn {
            border-radius: 8px;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }

        .stat-card {
            border-radius: 14px;
            padding: 22px 24px;
            color: #fff;
            border: none;
        }

            .stat-card .stat-icon {
                width: 48px;
                height: 48px;
                background: rgba(255,255,255,.2);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
            }

            .stat-card h3 {
                font-size: 2rem;
                font-weight: 800;
                margin: 8px 0 2px;
            }

            .stat-card p {
                margin: 0;
                opacity: .85;
                font-size: .875rem;
            }

        .form-label {
            font-weight: 600;
            font-size: .875rem;
            color: #374151;
            margin-bottom: 5px;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1.5px solid #e2e8f0;
            padding: 9px 12px;
            font-size: .9rem;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(37,99,235,.12);
            }

        .form-text {
            color: #94a3b8;
            font-size: .78rem;
        }

        .alert {
            border: none;
            border-radius: 10px;
        }

        .lang-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #f1f5f9;
            border-radius: 6px;
            padding: 2px 8px;
            font-size: .78rem;
            font-weight: 600;
        }

        .block-item {
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 10px;
            background: #fff;
        }

            .block-item:hover {
                border-color: var(--primary);
                background: #f8faff;
            }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #94a3b8;
        }

            .empty-state i {
                font-size: 3rem;
                display: block;
                margin-bottom: 12px;
            }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/Dashboard" class="brand"><i class="bi bi-layers-fill"></i>ICT</a>
        @if (ViewBag.IsLoggedIn == true)
        {
            <div class="ms-auto">
                <span class="me-1 text-muted small">Hello,</span>
                <strong class="me-3">@ViewBag.CurrentUsername</strong>
                @* <span class="badge @(ViewBag.CurrentRole == "admin" ? "badge-admin" : "badge-user") me-3">@ViewBag.CurrentRole</span> *@
                <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </a>
            </div>
        }
    </div>

    <!-- SIDEBAR -->
    @if (ViewBag.IsLoggedIn == true)
    {
        <div class="sidebar">
            <div class="sidebar-section">Overview</div>
            <a href="/Dashboard" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <div class="sidebar-section mt-2">Content</div>
            <a href="/Field" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Field" ? "active" : "")">
                <i class="bi bi-grid-3x3-gap"></i> Fields
            </a>
            <a href="/Service" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Service" ? "active" : "")">
                <i class="bi bi-gear"></i> Services
            </a>
            <a href="/Project" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Project" ? "active" : "")">
                <i class="bi bi-folder2-open"></i> Projects
            </a>
            <div class="sidebar-section mt-2">Interactions</div>
            <a href="/Contact" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")">
                <i class="bi bi-envelope"></i> Contacts
            </a>
            @if (ViewBag.IsAdmin == true)
            {
                <div class="sidebar-section mt-2">System</div>
                <a href="/User" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                    <i class="bi bi-people"></i> Users
                </a>
            }
        </div>
    }

    <!-- MAIN -->
    <div class="@(ViewBag.IsLoggedIn == true ? "main-wrap" : "")">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
