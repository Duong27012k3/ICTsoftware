@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard</h4>
        <p>Welcome back, <strong>@ViewBag.CurrentUsername</strong>! Here's your system overview.</p>
    </div>
    <span class="text-muted small">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#2563eb,#1d4ed8)">
            <div class="d-flex justify-content-between align-items-start">
                <div><p>Fields</p><h3>@ViewBag.TotalFields</h3></div>
                <div class="stat-icon"><i class="bi bi-grid-3x3-gap"></i></div>
            </div>
            <a href="/Field" class="text-white-50 small text-decoration-none">View all →</a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#059669,#047857)">
            <div class="d-flex justify-content-between align-items-start">
                <div><p>Services</p><h3>@ViewBag.TotalServices</h3></div>
                <div class="stat-icon"><i class="bi bi-gear"></i></div>
            </div>
            <a href="/Service" class="text-white-50 small text-decoration-none">View all →</a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#d97706,#b45309)">
            <div class="d-flex justify-content-between align-items-start">
                <div><p>Projects</p><h3>@ViewBag.TotalProjects</h3></div>
                <div class="stat-icon"><i class="bi bi-folder2-open"></i></div>
            </div>
            <a href="/Project" class="text-white-50 small text-decoration-none">View all →</a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#dc2626,#b91c1c)">
            <div class="d-flex justify-content-between align-items-start">
                <div><p>Contacts</p><h3>@ViewBag.TotalContacts</h3></div>
                <div class="stat-icon"><i class="bi bi-envelope"></i></div>
            </div>
            <a href="/Contact" class="text-white-50 small text-decoration-none">View all →</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Recent Contacts -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between">
                <span><i class="bi bi-envelope me-2 text-danger"></i>Recent Contacts</span>
                <a href="/Contact" class="btn btn-outline-secondary btn-sm">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Name</th><th>Email</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                        @if (ViewBag.RecentContacts != null)
                        {
                            foreach (var c in ViewBag.RecentContacts)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td class="text-muted">@c.Email</td>
                                    <td class="text-muted small">@c.CreatedAt.ToString("MM/dd HH:mm")</td>
                                    <td>
                                        <a href="/Contact/Details/@c.ContactId" class="btn btn-icon btn-outline-primary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Access -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white"><i class="bi bi-lightning me-2 text-warning"></i>Quick Actions</div>
            <div class="card-body d-grid gap-2">
                <a href="/Field/Create" class="btn btn-outline-primary  text-start"><i class="bi bi-plus-lg me-2"></i>Add new field</a>
                <a href="/Service/Create" class="btn btn-outline-success  text-start"><i class="bi bi-plus-lg me-2"></i>Add new service</a>
                <a href="/Project/Create" class="btn btn-outline-warning  text-start"><i class="bi bi-plus-lg me-2"></i>Add new project</a>
                <a href="/Contact" class="btn btn-outline-danger   text-start"><i class="bi bi-envelope me-2"></i>View contacts</a>
                @if (ViewBag.IsAdmin == true)
                {
                    <a href="/User/Create" class="btn btn-outline-secondary text-start"><i class="bi bi-person-plus me-2"></i>Add new user</a>
                }
            </div>
        </div>
    </div>
</div>
