@model Entity.Contact
@{
    ViewData["Title"] = "Contact Details";
}

<div class="page-header d-flex align-items-center gap-3">
    <a href="/Contact" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-envelope-open text-primary me-2"></i>Contact #@Model.ContactId</h4>
</div>

<div class="card" style="max-width:640px">
    <div class="card-header bg-white">Sender Information</div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-4 text-muted">Full Name</dt>
            <dd class="col-8 fw-semibold">@Model.Name</dd>

            <dt class="col-4 text-muted">Email</dt>
            <dd class="col-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

            <dt class="col-4 text-muted">Phone</dt>
            <dd class="col-8">@(Model.Phone ?? "—")</dd>

            <dt class="col-4 text-muted">Date</dt>
            <dd class="col-8 text-muted small">@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm:ss")</dd>

            <dt class="col-4 text-muted mt-2">Message</dt>
            <dd class="col-8 mt-2">
                <div class="bg-light p-3 rounded" style="white-space:pre-wrap">@Model.Message</div>
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <a href="mailto:@Model.Email" class="btn btn-primary">
            <i class="bi bi-reply me-1"></i>Reply
        </a>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.ContactId" />
            <button type="submit" class="btn btn-outline-danger"
                    onclick="return confirm('Delete this contact?')">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
        <a href="/Contact" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
