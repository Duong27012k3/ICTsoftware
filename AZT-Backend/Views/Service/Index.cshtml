@model IEnumerable<Entity.Service>
@{
    ViewData["Title"] = "Services";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="bi bi-gear text-success me-2"></i>Services</h4>
        <p>Manage your service listings</p>
    </div>
    <a href="/Service/Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Add Service</a>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2 px-3">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="input-group" style="max-width:300px">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search service name..." oninput="applyFilters()" />
            </div>
            <select id="fieldFilter" class="form-select" style="width:160px" onchange="applyFilters()">
                <option value="">All Fields</option>
                @foreach (var f in Model.Select(s => s.Field).Where(f => f != null)
                                .GroupBy(f => f!.FieldId).Select(g => g.First()).OrderBy(f => f!.Uid))
                {
                    var fn = f!.FieldTrans?.FirstOrDefault(t => t.LangCode == "en")?.Name ?? f.Uid;
                    <option value="@fn.ToLower()">@fn</option>
                }
            </select>
            <select id="statusFilter" class="form-select" style="width:140px" onchange="applyFilters()">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <select id="pageSizeSelect" class="form-select" style="width:120px" onchange="applyFilters()">
                <option value="10">10 / page</option>
                <option value="15">15 / page</option>
                <option value="20">20 / page</option>
                <option value="25">25 / page</option>
            </select>
            <span id="resultCount" class="text-muted small ms-auto"></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="sortable" data-col="0">Service Name <i class="bi bi-chevron-expand text-muted small"></i></th>
                    <th class="sortable" data-col="1">Field <i class="bi bi-chevron-expand text-muted small"></i></th>
                    <th class="sortable text-center" data-col="2">Trans <i class="bi bi-chevron-expand text-muted small"></i></th>
                    <th class="sortable" data-col="3">Status <i class="bi bi-chevron-expand text-muted small"></i></th>
                    <th class="sortable" data-col="4">Created <i class="bi bi-chevron-expand text-muted small"></i></th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var s in Model)
                {
                    var name = s.ServiceTrans?.FirstOrDefault(t => t.LangCode == "en")?.Name
                    ?? s.ServiceTrans?.FirstOrDefault()?.Name ?? "— no name —";
                    var fieldName = s.Field?.FieldTrans?.FirstOrDefault(t => t.LangCode == "en")?.Name
                    ?? s.Field?.Uid ?? "—";
                    <tr data-name="@name.ToLower()" data-field="@fieldName.ToLower()"
                        data-trans="@(s.ServiceTrans?.Count ?? 0)" data-status="@s.Status"
                        data-created="@s.CreatedAt.ToString("yyyy-MM-dd")">
                        <td>
                            <p class="fw-semibold mb-0">@name</p>
                            @if (!string.IsNullOrEmpty(s.CatalogueUrl))
                            {
                                <a href="@s.CatalogueUrl" target="_blank" class="text-muted small"><i class="bi bi-file-earmark-pdf text-danger me-1"></i>Catalogue</a>
                            }
                        </td>
                        <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3">@fieldName</span></td>
                        <td class="text-center"><span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">@(s.ServiceTrans?.Count ?? 0)</span></td>
                        <td><span class="@(s.Status == "active" ? "badge-active" : "badge-inactive")">@s.Status</span></td>
                        <td class="text-muted small">@s.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="/Block?ownerType=service&ownerId=@s.ServiceId" class="btn btn-icon btn-outline-secondary btn-sm me-1" title="Blocks"><i class="bi bi-layout-text-window"></i></a>
                            <a href="/Service/Edit/@s.ServiceId" class="btn btn-icon btn-outline-primary btn-sm me-1"><i class="bi bi-pencil"></i></a>
                            <a href="/Service/Delete/@s.ServiceId" class="btn btn-icon btn-outline-danger  btn-sm"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top" id="paginationBar">
        <span id="pageInfo" class="text-muted small"></span>
        <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
    </div>
</div>

<style>
    .sortable {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

        .sortable:hover {
            background: #f8f9fa;
        }

    .sort-asc .bi-chevron-expand::before {
        content: "\f235";
    }

    .sort-desc .bi-chevron-expand::before {
        content: "\f229";
    }
</style>

<script>
    let currentPage = 1, sortCol = -1, sortAsc = true;

    function applyFilters() { currentPage = 1; render(); }

    function getRows() {
        const q      = document.getElementById('searchInput').value.toLowerCase();
        const field  = document.getElementById('fieldFilter').value;
        const status = document.getElementById('statusFilter').value;
        return [...document.querySelectorAll('#tableBody tr')].filter(r => {
            return (!q      || r.dataset.name.includes(q))
                && (!field  || r.dataset.field === field)
                && (!status || r.dataset.status === status);
        });
    }

    function render() {
        const pageSize = parseInt(document.getElementById('pageSizeSelect').value);
        let rows = getRows();

        if (sortCol >= 0) {
            const keys = ['name','field','trans','status','created'];
            rows.sort((a, b) => {
                const av = isNaN(a.dataset[keys[sortCol]]) ? a.dataset[keys[sortCol]] : +a.dataset[keys[sortCol]];
                const bv = isNaN(b.dataset[keys[sortCol]]) ? b.dataset[keys[sortCol]] : +b.dataset[keys[sortCol]];
                return sortAsc ? (av > bv ? 1 : av < bv ? -1 : 0) : (av < bv ? 1 : av > bv ? -1 : 0);
            });
        }

        document.querySelectorAll('#tableBody tr').forEach(r => r.style.display = 'none');
        const total = rows.length;
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        currentPage = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * pageSize;
        rows.slice(start, start + pageSize).forEach(r => r.style.display = '');

        document.getElementById('resultCount').textContent = `${total} result${total !== 1 ? 's' : ''}`;
        document.getElementById('pageInfo').textContent =
            total ? `Showing ${start+1}–${Math.min(start+pageSize,total)} of ${total}` : 'No results';

        const ul = document.getElementById('pagination');
        ul.innerHTML = '';
        const addBtn = (label, page, disabled, active) => {
            const li = document.createElement('li');
            li.className = `page-item${disabled?' disabled':''}${active?' active':''}`;
            li.innerHTML = `<a class="page-link" href="#">${label}</a>`;
            if (!disabled && !active) li.onclick = e => { e.preventDefault(); currentPage = page; render(); };
            ul.appendChild(li);
        };
        addBtn('«', 1, currentPage===1);
        addBtn('‹', currentPage-1, currentPage===1);
        const from = Math.max(1,currentPage-2), to = Math.min(totalPages,from+4);
        for (let i = from; i <= to; i++) addBtn(i, i, false, i===currentPage);
        addBtn('›', currentPage+1, currentPage===totalPages);
        addBtn('»', totalPages, currentPage===totalPages);
    }

    document.querySelectorAll('.sortable').forEach(th => {
        th.onclick = () => {
            const col = +th.dataset.col;
            if (sortCol === col) sortAsc = !sortAsc;
            else { sortCol = col; sortAsc = true; }
            document.querySelectorAll('.sortable').forEach(t => t.classList.remove('sort-asc','sort-desc'));
            th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
            render();
        };
    });

    render();
</script>
