@model Entity.Service
@{
    ViewData["Title"] = "Edit Service";
    var _name = Model.ServiceTrans?.FirstOrDefault(t => t.LangCode == "en")?.Name ?? Model.ServiceTrans?.FirstOrDefault()?.Name ?? $"Field#{Model.ServiceId}";
}

<div class="page-header d-flex align-items-center gap-3">
    <a href="/Service" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-pencil text-warning me-2"></i>Edit Service @_name</h4>
</div>

<div class="row g-4">
    <!-- Main Info -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Main Information</div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.ServiceId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @* <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div> *@

                    <div class="mb-3">
                        <label class="form-label">Field</label>
                        <select asp-for="FieldId" asp-items="ViewBag.FieldList" class="form-select"></select>
                    </div>

                    <!-- IMAGE -->
                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" class="d-block mb-2 rounded" style="max-height:80px;max-width:100%" />
                            <span class="badge bg-secondary mb-2">Current image</span>
                        }
                        <input type="file" name="imageFile" class="form-control" accept="image/*"
                               onchange="previewImg(this,'imgPrev')" />
                        <div class="form-text">Chọn ảnh mới để thay thế — max 5MB</div>
                        <img id="imgPrev" src="#" class="mt-2 rounded d-none" style="max-height:80px;max-width:100%" />
                        <input type="hidden" asp-for="Image" />
                    </div>

                    <!-- CATALOGUE -->
                    <div class="mb-3">
                        <label class="form-label">Catalogue (PDF)</label>
                        @if (!string.IsNullOrEmpty(Model.CatalogueUrl))
                        {
                            <div class="mb-2">
                                <a href="@Model.CatalogueUrl" target="_blank" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-file-earmark-pdf me-1 text-danger"></i>View current PDF
                                </a>
                            </div>
                        }
                        <input type="file" name="catalogueFile" class="form-control" accept=".pdf"
                               onchange="showFilename(this,'catName')" />
                        <div class="form-text">Upload PDF mới để thay thế — max 20MB</div>
                        <div id="catName" class="text-success small mt-1 d-none">
                            <i class="bi bi-file-earmark-pdf me-1"></i><span></span>
                        </div>
                        <input type="hidden" asp-for="CatalogueUrl" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Update</button>
                        <a href="/Block?ownerType=service&ownerId=@Model.ServiceId" class="btn btn-outline-secondary">
                            <i class="bi bi-layout-text-window me-1"></i>Manage Blocks
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Translations -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-translate text-primary me-2"></i>Translations</span>
                <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#addTrans">
                    <i class="bi bi-plus-lg me-1"></i>Add
                </button>
            </div>
            <div class="card-body p-0">
                <div class="collapse border-bottom" id="addTrans">
                    <div class="p-4 bg-light">
                        <form asp-action="AddTrans" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ServiceId" value="@Model.ServiceId" />
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="form-label small">Language</label>
                                    <select name="LangCode" class="form-select form-select-sm">
                                        <option value="vi">🇻🇳 Vietnamese</option>
                                        <option value="en">🇺🇸 English</option>
                                        <option value="zh">🇨🇳 Chinese</option>
                                        <option value="ja">🇯🇵 Japanese</option>
                                    </select>
                                </div>
                                <div class="col-8">
                                    <label class="form-label small">Name <span class="text-danger">*</span></label>
                                    <input name="Name" class="form-control form-control-sm" placeholder="Tên dịch vụ..." required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">Short Description</label>
                                    <textarea name="ShortDescription" class="form-control form-control-sm" rows="2" placeholder="Mô tả ngắn..."></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg me-1"></i>Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                @if (Model.ServiceTrans == null || !Model.ServiceTrans.Any())
                {
                    <div class="empty-state py-5"><i class="bi bi-translate"></i>No translations yet</div>
                }
                @foreach (var t in Model.ServiceTrans ?? new List<Entity.ServiceTrans>())
                {
                    <div class="d-flex align-items-start p-3 border-bottom gap-3">
                        <span class="lang-badge">@t.LangCode.ToUpper()</span>
                        <div class="flex-grow-1">
                            <p class="fw-semibold mb-0">@t.Name</p>
                            @if (!string.IsNullOrEmpty(t.ShortDescription))
                            {
                                <p class="text-muted small mb-0">@t.ShortDescription</p>
                            }
                        </div>
                        <form asp-action="DeleteTrans" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="transId" value="@t.ServiceTransId" />
                            <input type="hidden" name="serviceId" value="@Model.ServiceId" />
                            <button type="submit" class="btn btn-icon btn-outline-danger btn-sm"
                                    onclick="return confirm('Delete this translation?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function previewImg(input, previewId) {
        const img = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => { img.src = e.target.result; img.classList.remove('d-none'); };
            reader.readAsDataURL(input.files[0]);
        }
    }
    function showFilename(input, divId) {
        const div = document.getElementById(divId);
        if (input.files && input.files[0]) {
            div.querySelector('span').textContent = input.files[0].name;
            div.classList.remove('d-none');
        }
    }
</script>
