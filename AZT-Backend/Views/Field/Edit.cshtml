@model Entity.Field
@{
    ViewData["Title"] = "Edit Field";
    var _name = Model.FieldTrans?.FirstOrDefault(t => t.LangCode == "en")?.Name ?? Model.FieldTrans?.FirstOrDefault()?.Name ?? $"Field#{Model.FieldId}";
}

<div class="page-header d-flex align-items-center gap-3">
    <a href="/Field" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-pencil text-warning me-2"></i>Edit @_name</h4>
</div>

<div class="row g-4">
    <!-- Main Info -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Main Information</div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.FieldId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @* <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div> *@

                    <div class="mb-3">
                        <label asp-for="Uid" class="form-label">Slug/UID</label>
                        <input asp-for="Uid" class="form-control" />
                        <span asp-validation-for="Uid" class="text-danger small"></span>
                    </div>

                    <!-- IMAGE -->
                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div class="mb-2 position-relative d-inline-block">
                                <img src="@Model.Image" class="rounded" style="max-height:90px;max-width:100%;display:block" />
                                <span class="badge bg-secondary mt-1">Current image</span>
                            </div>
                        }
                        <input type="file" name="imageFile" class="form-control" accept="image/*"
                               onchange="previewImg(this,'imgPrev')" />
                        <div class="form-text">Select a new image to replace — JPG, PNG, WEBP, max 5MB</div>
                        <img id="imgPrev" src="#" class="mt-2 rounded d-none" style="max-height:90px;max-width:100%" />
                        <!-- Giữ lại path cũ nếu không upload mới -->
                        <input type="hidden" asp-for="Image" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-warning w-100"><i class="bi bi-check-lg me-1"></i>Update</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Translations -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-translate text-primary me-2"></i>Translations</span>
                <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#addTransForm">
                    <i class="bi bi-plus-lg me-1"></i>Add
                </button>
            </div>
            <div class="card-body p-0">
                <div class="collapse border-bottom" id="addTransForm">
                    <div class="p-4 bg-light">
                        <form asp-action="AddTrans" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="FieldId" value="@Model.FieldId" />
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="form-label small">Language</label>
                                    <select name="LangCode" class="form-select form-select-sm">
                                        <option value="vi">🇻🇳 Vietnamese</option>
                                        <option value="en">🇺🇸 English</option>
                                        <option value="zh">🇨🇳 Chinese</option>
                                        <option value="ja">🇯🇵 Japanese</option>
                                    </select>
                                </div>
                                <div class="col-8">
                                    <label class="form-label small">Name <span class="text-danger">*</span></label>
                                    <input name="Name" class="form-control form-control-sm" placeholder="Tên lĩnh vực..." required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">Description</label>
                                    <textarea name="Description" class="form-control form-control-sm" rows="2" placeholder="Mô tả ngắn..."></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg me-1"></i>Save Translation</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                @if (Model.FieldTrans == null || !Model.FieldTrans.Any())
                {
                    <div class="empty-state py-5"><i class="bi bi-translate"></i>No translations yet</div>
                }
                @foreach (var t in Model.FieldTrans ?? new List<Entity.FieldTrans>())
                {
                    <div class="d-flex align-items-start p-3 border-bottom gap-3">
                        <span class="lang-badge">@t.LangCode.ToUpper()</span>
                        <div class="flex-grow-1">
                            <p class="fw-semibold mb-0">@t.Name</p>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <p class="text-muted small mb-0">@t.Description</p>
                            }
                        </div>
                        <form asp-action="DeleteTrans" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="transId" value="@t.FieldTransId" />
                            <input type="hidden" name="fieldId" value="@Model.FieldId" />
                            <button type="submit" class="btn btn-icon btn-outline-danger btn-sm"
                                    onclick="return confirm('Delete this translation?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function previewImg(input, previewId) {
        const img = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => { img.src = e.target.result; img.classList.remove('d-none'); };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
